{
  "uid": "ss-moderation",
  "title": "S&S Moderation",
  "tags": [
    "scavengesurvive"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "player",
        "label": "Player (regex, case-insensitive)",
        "type": "textbox",
        "query": "Bob",
        "current": {
          "text": "Bob",
          "value": "Bob"
        },
        "options": [
          {
            "selected": true,
            "text": "Bob",
            "value": "Bob"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 11,
      "type": "logs",
      "title": "Player timeline (every line mentioning the player)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"ss-game\"} |~ \"(?i)\\\"$player\\\"\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Staff actions",
      "datasource": {
        "type": "loki",
