# Copy to /etc/scavengesurvive-mailer.env (mode 0640, owner root, group mta) and fill in the secrets.
# Gmail: SMTP_PASS is an app password (Google account > Security > 2-Step Verification > App passwords).
SMTP_USER=someone@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=someone@gmail.com
MAIL_FROM_NAME="Scavenge & Survive"
SSMTA_DB_HOST=127.0.0.1
SSMTA_DB_NAME=scavengesurvive
SSMTA_DB_USER=ssmta_mailer
SSMTA_DB_PASS=change-me
# MAILER_POLL_S=2
