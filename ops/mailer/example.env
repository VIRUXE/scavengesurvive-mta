# Copy to /etc/scavengesurvive-mailer.env (mode 0640, owner root, group mta) and fill in the secrets.
# Prod: Brevo (login and SMTP key under Brevo > Settings > SMTP & API), DKIM-signed for the domain.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_USER=xxxxxxxxx@smtp-brevo.com
SMTP_PASS=xsmtpsib-...
# Gmail fallback: SMTP_HOST=smtp.gmail.com, SMTP_USER=someone@gmail.com, SMTP_PASS an app password; MAIL_FROM
# must then be a "Send mail as" alias verified on that account (Settings > Accounts).
MAIL_FROM=admin@scavengesurvive-reborn.com
MAIL_FROM_NAME="Scavenge & Survive"
SSMTA_DB_HOST=127.0.0.1
SSMTA_DB_NAME=scavengesurvive
SSMTA_DB_USER=ssmta_mailer
SSMTA_DB_PASS=change-me
# MAILER_POLL_S=2
