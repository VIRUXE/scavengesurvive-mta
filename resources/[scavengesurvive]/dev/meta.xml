<meta>
    <info author="scavengesurvive-mta" type="script" name="dev" description="Developer commands for local testing" version="0.1.0"/>
    <min_mta_version server="1.6.0" client="1.6.0"/>
    <include resource="lib"/>
    <include resource="maps"/>
    <include resource="auth"/>
    <include resource="character"/>
    <include resource="items"/>
    <include resource="loot"/>
    <include resource="hud"/>
    <script src="shared/events.lua" type="shared"/>
    <script src="server/main.lua" type="server"/>
    <script src="client/main.lua" type="client"/>
    <script src="client/studio.lua" type="client"/>
    <file src="shared/logic/studio.lua"/>
    <export function="rcon" type="server" http="true"/>
    <export function="isHeld" type="client"/>
    <aclrequest>
        <right name="function.restartResource" access="true"/>
        <right name="function.startResource" access="true"/>
        <right name="function.stopResource" access="true"/>
        <right name="function.shutdown" access="true"/>
        <right name="function.executeCommandHandler" access="true"/>
        <right name="function.addAccount" access="true"/>
        <right name="function.setAccountPassword" access="true"/>
    </aclrequest>
    <settings>
        <setting name="*open" value="true" friendlyname="Everyone may use dev commands"/>
        <setting name="*http_user" value="rcon" friendlyname="Account for the HTTP rcon export"/>
        <setting name="*http_pass" value="" friendlyname="Its password; empty disables the rcon account"/>
    </settings>
</meta>
